# Template of a per-domain nginx snippet. The certbot script writes one such file per hostname
# once Let's Encrypt has issued a certificate for it. Do not include this file in nginx: the
# .example extension keeps it out of /etc/nginx/sites/*.conf.
#
# Variables filled by renew.sh:
#   {HOST}        — the hostname (mon-ecole-1.ci)
#   {CERT_PATH}   — /etc/letsencrypt/live/<host>/fullchain.pem
#   {KEY_PATH}    — /etc/letsencrypt/live/<host>/privkey.pem

server {
  listen 443 ssl;
  http2 on;
  server_name {HOST};

  ssl_certificate     {CERT_PATH};
  ssl_certificate_key {KEY_PATH};
  ssl_protocols       TLSv1.2 TLSv1.3;
  ssl_session_cache   shared:SSL:10m;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options nosniff always;

  location /.well-known/acme-challenge/ { root /var/www/certbot; }

  location /api/auth/ {
    limit_req zone=auth burst=10 nodelay;
    proxy_pass http://api;
    include /etc/nginx/proxy_params.conf;
  }

  location /api/ {
    limit_req zone=api burst=60 nodelay;
    proxy_pass http://api;
    include /etc/nginx/proxy_params.conf;
    proxy_buffering off;
    proxy_read_timeout 120s;
  }

  location / {
    proxy_pass http://web;
    include /etc/nginx/proxy_params.conf;
  }
}
