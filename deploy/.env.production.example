# Production configuration — copy to .env.production at the project root and replace EVERY value.
# Generate secrets with:  openssl rand -base64 48   (DATA_ENCRYPTION_KEY: openssl rand -base64 32)
# Never commit .env.production.

APP_VERSION=1.2.0
PUBLIC_URL=https://ecole.example.ci
TZ=Africa/Abidjan

# Database
DB_USER=school_erp
DB_PASSWORD=remplacer-par-un-mot-de-passe-long-et-unique
DB_NAME=school_erp

# Cache / rate limits
REDIS_PASSWORD=remplacer-par-un-secret-redis

# Authentication
JWT_SECRET=remplacer-par-au-moins-32-caracteres-aleatoires-xxxxxxxx
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
TOTP_REQUIRED_ROLES=SUPER_ADMIN,ADMIN_ORGANISATION,DIRECTOR,COMPTABLE

# Encryption of sensitive personal data (health, documents) — 32 random bytes, base64
DATA_ENCRYPTION_KEY=remplacer-par-32-octets-en-base64-xxxxxxxxxxxx=

# Uploaded documents — STORAGE_DRIVER: local (Docker volume) or s3 (AWS S3, MinIO, Scaleway, B2…)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Public address of the bucket for website images (CDN or public bucket URL)
S3_PUBLIC_URL=
# Antivirus: start the stack with --profile antivirus and set CLAMAV_HOST=clamav.
# CLAMAV_REQUIRED=true refuses uploads while the antivirus is unreachable.
CLAMAV_HOST=
CLAMAV_REQUIRED=false

# E-mail (password reset, notifications)
MAIL_HOST=smtp.example.ci
MAIL_PORT=587
MAIL_USER=no-reply@example.ci
MAIL_PASS=remplacer
MAIL_FROM=School ERP <no-reply@example.ci>

# SMS / WhatsApp — SMS_PROVIDER: log (nothing sent, journal only), orange, twilio
# Messages: absences, overdue reminders (every morning), payment receipts, admission convocations.
SMS_PROVIDER=log
SMS_DEFAULT_COUNTRY_CODE=225
# Daily job (overdue invoices + reminders): hour of the day, server time; SCHEDULER_ENABLED=false to switch off
SCHEDULER_HOUR=8
SCHEDULER_ENABLED=true
ORANGE_SMS_SENDER_NAME=
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_SENDER=tel:+2250000000000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=

# Mobile Money and card payment links (CinetPay) — leave empty to keep payments manual.
# In the CinetPay back office, set the notification URL to ${PUBLIC_URL}/api/payments/cinetpay/notify
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=

# Monitoring (optional)
SENTRY_DSN=
# Prometheus scrapes /api/metrics with this bearer token (empty = metrics closed). Alert rules: deploy/monitoring/alerts.yml
METRICS_TOKEN=
LOG_LEVEL=info

# Backups: passphrase of the encrypted archives (keep a copy OFF the server!) and retention
BACKUP_PASSPHRASE=remplacer-par-une-phrase-secrete-longue
BACKUP_RETENTION_DAYS=30
# Off-site copy with rclone (configure deploy/rclone/rclone.conf), e.g. s3:school-erp-backups
RCLONE_REMOTE=

# Self-service: let schools create their own space at /signup, with a free trial of TRIAL_DAYS days.
# After the trial a school is read-only until its subscription is activated in "Plateforme" (SUPER_ADMIN).
SIGNUP_ENABLED=false
TRIAL_DAYS=30

# Push notifications on the devices that ask for them. Generate the pair ONCE and keep it:
#   docker compose -f docker-compose.prod.yml run --rm backend node scripts/generate-vapid.js
# Leave empty to keep push off. No content of a notification travels through the push service.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.ci

# Optional integrations
ANTHROPIC_API_KEY=
DIFY_CHATBOT_API_KEY=
DIFY_AGENT_API_KEY=
SWAGGER_ENABLED=false
