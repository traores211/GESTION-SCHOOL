# Database
DB_USER=schooladmin
DB_PASSWORD=SchoolAdmin123!
DB_NAME=school_erp
DATABASE_URL=postgresql://schooladmin:SchoolAdmin123!@localhost:5432/school_erp

# Redis
REDIS_URL=redis://localhost:6379

# LDAP
LDAP_URL=ldap://openldap:389
LDAP_BASE_DN=dc=school,dc=local
LDAP_ADMIN_DN=cn=admin,dc=school,dc=local
LDAP_ADMIN_PASSWORD=LdapAdmin123!
LDAP_PASSWORD=LdapAdmin123!

# JWT
JWT_SECRET=your-super-secret-key-change-in-production-at-least-32-chars
JWT_EXPIRATION=24h

# Mail
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@school.local

# App URLs
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:1300
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Multi-tenant SaaS: the hostname of the platform portal, and the suffix under which schools
# get an automatic subdomain (<slug>.<suffix>). Leave empty in dev to use localhost.
# Example in production:
#   PLATFORM_HOSTNAME=mon-saas-ecole.ci
#   PLATFORM_SUBDOMAIN_SUFFIX=mon-saas-ecole.ci
PLATFORM_HOSTNAME=
PLATFORM_SUBDOMAIN_SUFFIX=

# Automatic Let's Encrypt certificates for the custom domains. Shared bearer token the certbot
# container presents to the API. Generate once (`openssl rand -base64 32`) and set the same
# value on both the API and the certbot service. Also fill in CERTBOT_EMAIL (contact given to
# Let's Encrypt for expiry notifications).
CERTBOT_TOKEN=
CERTBOT_EMAIL=
# "true" to use the Let's Encrypt staging endpoint (untrusted certs, no rate limit).
CERTBOT_STAGING=false

# Host port of the frontend container
FRONTEND_PORT=1300

# Optional: AI analysis of imported timetables (documents, photos). Leave empty to use local extraction only.
ANTHROPIC_API_KEY=
TIMETABLE_AI_MODEL=claude-opus-5

# Environment
NODE_ENV=development

# Assistant (Dify) — see dify/README.md. Leave the keys empty to disable the assistant.
DIFY_API_URL=https://api.dify.ai/v1
DIFY_CHATBOT_API_KEY=
DIFY_AGENT_API_KEY=
# Public https URL of this API reachable by Dify (needed by the agent's tools), e.g. https://xxxx.trycloudflare.com/api
ASSISTANT_TOOLS_PUBLIC_URL=
